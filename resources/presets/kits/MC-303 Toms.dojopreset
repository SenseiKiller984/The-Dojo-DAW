<?xml version="1.0" encoding="UTF-8"?>
<!-- Built-in drum kit (tools/drumkits/make_kits.py): the Roland MC-303's samples, arranged on the
     Drum Rack's pads, with a demo beat the browser plays when the kit is selected. -->
<DOJO_PRESET version="1" name="MC-303 Toms" category="Drums" kit="1" machine="Roland MC-303"
             description="More of the Roland MC-303's toms, one per pad: its demo plays each in turn.">
  <DEVICE key="builtin:drumrack" name="Drum Rack">
    <DOJO_DEVICE type="builtin:drumrack" version="1">
      <PARAM id="pad1Volume" value="0.0"/>
      <PARAM id="pad1Pan" value="0.0"/>
      <PARAM id="pad1Pitch" value="0.0"/>
      <PARAM id="pad1Output" value="0.0"/>
      <PARAM id="pad1Choke" value="0.0"/>
      <PARAM id="pad2Volume" value="0.0"/>
      <PARAM id="pad2Pan" value="0.0"/>
      <PARAM id="pad2Pitch" value="0.0"/>
      <PARAM id="pad2Output" value="0.0"/>
      <PARAM id="pad2Choke" value="0.0"/>
      <PARAM id="pad3Volume" value="0.0"/>
      <PARAM id="pad3Pan" value="0.0"/>
      <PARAM id="pad3Pitch" value="0.0"/>
      <PARAM id="pad3Output" value="0.0"/>
      <PARAM id="pad3Choke" value="0.0"/>
      <PARAM id="pad4Volume" value="0.0"/>
      <PARAM id="pad4Pan" value="0.0"/>
      <PARAM id="pad4Pitch" value="0.0"/>
      <PARAM id="pad4Output" value="0.0"/>
      <PARAM id="pad4Choke" value="0.0"/>
