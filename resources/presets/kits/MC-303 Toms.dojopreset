      <PARAM id="pad14Choke" value="0.0"/>
      <PARAM id="pad15Volume" value="0.0"/>
      <PARAM id="pad15Pan" value="0.0"/>
      <PARAM id="pad15Pitch" value="0.0"/>
      <PARAM id="pad15Output" value="0.0"/>
      <PARAM id="pad15Choke" value="0.0"/>
      <PARAM id="pad16Volume" value="0.0"/>
      <PARAM id="pad16Pan" value="0.0"/>
      <PARAM id="pad16Pitch" value="0.0"/>
      <PARAM id="pad16Output" value="0.0"/>
      <PARAM id="pad16Choke" value="0.0"/>
      <PARAM id="master" value="-3.0"/>
      <EXTRA>
        <PAD index="0" sample="kit:Roland MC-303/Acoustic Tom High 2.wav"/>
        <PAD index="1" sample="kit:Roland MC-303/Acoustic Tom Low 2.wav"/>
        <PAD index="2" sample="kit:Roland MC-303/Acoustic Tom Mid 2.wav"/>
        <PAD index="3" sample="kit:Roland MC-303/Electric Tom High 2.wav"/>
        <PAD index="4" sample="kit:Roland MC-303/Electric Tom Low 2.wav"/>
        <PAD index="5" sample="kit:Roland MC-303/Electric Tom Mid 2.wav"/>
        <PAD index="6" sample="kit:Roland MC-303/Synth Tom High.wav"/>
        <PAD index="7" sample="kit:Roland MC-303/Synth Tom Low.wav"/>
        <PAD index="8" sample="kit:Roland MC-303/Synth Tom Mid.wav"/>
      </EXTRA>
    </DOJO_DEVICE>
  </DEVICE>
  <DEMO tempo="110" bars="2" swing="0.0">
    <LANE pad="0" steps="x..............................."/>
    <LANE pad="1" steps="..x............................."/>
    <LANE pad="2" steps="....x..........................."/>
    <LANE pad="3" steps="......x........................."/>
    <LANE pad="4" steps="........x......................."/>
    <LANE pad="5" steps="..........x....................."/>
    <LANE pad="6" steps="............x..................."/>
    <LANE pad="7" steps="..............x................."/>
    <LANE pad="8" steps="................x..............."/>
  </DEMO>
</DOJO_PRESET>
