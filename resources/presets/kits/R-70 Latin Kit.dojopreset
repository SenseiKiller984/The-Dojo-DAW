<?xml version="1.0" encoding="UTF-8"?>
<!-- Built-in drum kit (tools/drumkits/make_kits.py): the Roland R-70's samples, arranged on the
     Drum Rack's pads, with a demo beat the browser plays when the kit is selected. -->
<DOJO_PRESET version="1" name="R-70 Latin Kit" category="Drums" kit="1" machine="Roland R-70"
             description="The R-70's latin percussion: surdo, congas, bongos, agogos, shekere and more.">
  <DEVICE key="builtin:drumrack" name="Drum Rack">
    <DOJO_DEVICE type="builtin:drumrack" version="1">
      <PARAM id="pad1Volume" value="0.0"/>
      <PARAM id="pad1Pan" value="0.0"/>
      <PARAM id="pad1Pitch" value="0.0"/>
      <PARAM id="pad1Output" value="0.0"/>
      <PARAM id="pad1Choke" value="0.0"/>
      <PARAM id="pad2Volume" value="-1.0"/>
      <PARAM id="pad2Pan" value="0.0"/>
      <PARAM id="pad2Pitch" value="0.0"/>
      <PARAM id="pad2Output" value="0.0"/>
      <PARAM id="pad2Choke" value="0.0"/>
      <PARAM id="pad3Volume" value="0.0"/>
      <PARAM id="pad3Pan" value="0.0"/>
      <PARAM id="pad3Pitch" value="0.0"/>
      <PARAM id="pad3Output" value="0.0"/>
      <PARAM id="pad3Choke" value="0.0"/>
      <PARAM id="pad4Volume" value="0.0"/>
      <PARAM id="pad4Pan" value="0.0"/>
      <PARAM id="pad4Pitch" value="0.0"/>
      <PARAM id="pad4Output" value="0.0"/>
      <PARAM id="pad4Choke" value="0.0"/>
      <PARAM id="pad5Volume" value="0.0"/>
      <PARAM id="pad5Pan" value="0.0"/>
      <PARAM id="pad5Pitch" value="0.0"/>
      <PARAM id="pad5Output" value="0.0"/>
      <PARAM id="pad5Choke" value="0.0"/>
      <PARAM id="pad6Volume" value="0.0"/>
      <PARAM id="pad6Pan" value="-0.3"/>
      <PARAM id="pad6Pitch" value="0.0"/>
      <PARAM id="pad6Output" value="0.0"/>
      <PARAM id="pad6Choke" value="0.0"/>
      <PARAM id="pad7Volume" value="-3.0"/>
      <PARAM id="pad7Pan" value="0.15"/>
      <PARAM id="pad7Pitch" value="0.0"/>
      <PARAM id="pad7Output" value="0.0"/>
      <PARAM id="pad7Choke" value="0.0"/>
      <PARAM id="pad8Volume" value="0.0"/>
      <PARAM id="pad8Pan" value="0.0"/>
      <PARAM id="pad8Pitch" value="0.0"/>
      <PARAM id="pad8Output" value="0.0"/>
      <PARAM id="pad8Choke" value="0.0"/>
      <PARAM id="pad9Volume" value="-4.0"/>
      <PARAM id="pad9Pan" value="0.15"/>
      <PARAM id="pad9Pitch" value="0.0"/>
      <PARAM id="pad9Output" value="0.0"/>
      <PARAM id="pad9Choke" value="0.0"/>
      <PARAM id="pad10Volume" value="0.0"/>
      <PARAM id="pad10Pan" value="0.3"/>
      <PARAM id="pad10Pitch" value="0.0"/>
      <PARAM id="pad10Output" value="0.0"/>
      <PARAM id="pad10Choke" value="0.0"/>
      <PARAM id="pad11Volume" value="-4.0"/>
      <PARAM id="pad11Pan" value="0.15"/>
      <PARAM id="pad11Pitch" value="0.0"/>
      <PARAM id="pad11Output" value="0.0"/>
      <PARAM id="pad11Choke" value="0.0"/>
      <PARAM id="pad12Volume" value="-2.0"/>
      <PARAM id="pad12Pan" value="-0.25"/>
      <PARAM id="pad12Pitch" value="0.0"/>
      <PARAM id="pad12Output" value="0.0"/>
      <PARAM id="pad12Choke" value="0.0"/>
      <PARAM id="pad13Volume" value="-2.0"/>
      <PARAM id="pad13Pan" value="0.25"/>
      <PARAM id="pad13Pitch" value="0.0"/>
      <PARAM id="pad13Output" value="0.0"/>
      <PARAM id="pad13Choke" value="0.0"/>
      <PARAM id="pad14Volume" value="-6.0"/>
      <PARAM id="pad14Pan" value="-0.2"/>
      <PARAM id="pad14Pitch" value="0.0"/>
      <PARAM id="pad14Output" value="0.0"/>
      <PARAM id="pad14Choke" value="0.0"/>
      <PARAM id="pad15Volume" value="-3.0"/>
      <PARAM id="pad15Pan" value="0.2"/>
      <PARAM id="pad15Pitch" value="0.0"/>
      <PARAM id="pad15Output" value="0.0"/>
      <PARAM id="pad15Choke" value="0.0"/>
      <PARAM id="pad16Volume" value="-6.0"/>
      <PARAM id="pad16Pan" value="0.25"/>
      <PARAM id="pad16Pitch" value="0.0"/>
      <PARAM id="pad16Output" value="0.0"/>
      <PARAM id="pad16Choke" value="0.0"/>
      <PARAM id="master" value="-3.0"/>
      <EXTRA>
        <PAD index="0" sample="kit:Roland R-70/Dry Kick.wav"/>
        <PAD index="1" sample="kit:Roland R-70/Claves.wav"/>
        <PAD index="2" sample="kit:Roland R-70/Latin Snare.wav"/>
        <PAD index="3" sample="kit:Roland R-70/Dance Clap.wav"/>
        <PAD index="4" sample="kit:Roland R-70/Cabasa Up.wav"/>
        <PAD index="5" sample="kit:Roland R-70/Surdo Open.wav"/>
        <PAD index="6" sample="kit:Roland R-70/Shaker.wav"/>
        <PAD index="7" sample="kit:Roland R-70/Conga Low Mute.wav"/>
        <PAD index="8" sample="kit:Roland R-70/Shekere.wav"/>
        <PAD index="9" sample="kit:Roland R-70/Conga High Mute.wav"/>
        <PAD index="10" sample="kit:Roland R-70/Cabasa Down.wav"/>
        <PAD index="11" sample="kit:Roland R-70/Conga Slap.wav"/>
        <PAD index="12" sample="kit:Roland R-70/Bongo High Open.wav"/>
        <PAD index="13" sample="kit:Roland R-70/Agogo High.wav"/>
        <PAD index="14" sample="kit:Roland R-70/Cowbell High Open.wav"/>
        <PAD index="15" sample="kit:Roland R-70/Timbale High.wav"/>
      </EXTRA>
    </DOJO_DEVICE>
  </DEVICE>
  <DEMO tempo="104" bars="2" swing="0.0">
    <LANE pad="0" steps="X.......X.......X.......X......."/>
    <LANE pad="1" steps="....X.......X.......X.......X..."/>
    <LANE pad="3" steps="..............................X."/>
    <LANE pad="8" steps="xoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxo"/>
    <LANE pad="11" steps="..x..x......x.....x..x......x.x."/>
    <LANE pad="12" steps="x...x..x.x..x...x...x..x.x..x..."/>
    <LANE pad="14" steps="X...x.x.X.x.x...X...x.x.X.x.x..."/>
  </DEMO>
</DOJO_PRESET>
