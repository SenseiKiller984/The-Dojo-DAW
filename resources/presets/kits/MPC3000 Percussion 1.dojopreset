      <PARAM id="pad6Pitch" value="0.0"/>
      <PARAM id="pad6Output" value="0.0"/>
      <PARAM id="pad6Choke" value="0.0"/>
      <PARAM id="pad7Volume" value="0.0"/>
      <PARAM id="pad7Pan" value="0.0"/>
      <PARAM id="pad7Pitch" value="0.0"/>
      <PARAM id="pad7Output" value="0.0"/>
      <PARAM id="pad7Choke" value="0.0"/>
      <PARAM id="pad8Volume" value="0.0"/>
      <PARAM id="pad8Pan" value="0.0"/>
      <PARAM id="pad8Pitch" value="0.0"/>
