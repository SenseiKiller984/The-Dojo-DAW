        <PAD index="6" sample="kit:Akai MPC3000/Cuica Low.wav"/>
        <PAD index="7" sample="kit:Akai MPC3000/Gated Cabasa.wav"/>
        <PAD index="8" sample="kit:Akai MPC3000/Gated Timbale High.wav"/>
        <PAD index="9" sample="kit:Akai MPC3000/Gated Timbale Low.wav"/>
        <PAD index="10" sample="kit:Akai MPC3000/Gated Wood Block.wav"/>
        <PAD index="11" sample="kit:Akai MPC3000/Log Drum High.wav"/>
        <PAD index="12" sample="kit:Akai MPC3000/Log Drum Low.wav"/>
        <PAD index="13" sample="kit:Akai MPC3000/Mark Tree.wav"/>
        <PAD index="14" sample="kit:Akai MPC3000/Metal Flange.wav"/>
        <PAD index="15" sample="kit:Akai MPC3000/Shekere Shake.wav"/>
      </EXTRA>
    </DOJO_DEVICE>
  </DEVICE>
  <DEMO tempo="110" bars="2" swing="0.0">
    <LANE pad="0" steps="x..............................."/>
    <LANE pad="1" steps="..x............................."/>
    <LANE pad="2" steps="....x..........................."/>
    <LANE pad="3" steps="......x........................."/>
    <LANE pad="4" steps="........x......................."/>
    <LANE pad="5" steps="..........x....................."/>
    <LANE pad="6" steps="............x..................."/>
    <LANE pad="7" steps="..............x................."/>
    <LANE pad="8" steps="................x..............."/>
    <LANE pad="9" steps="..................x............."/>
    <LANE pad="10" steps="....................x..........."/>
    <LANE pad="11" steps="......................x........."/>
    <LANE pad="12" steps="........................x......."/>
    <LANE pad="13" steps="..........................x....."/>
    <LANE pad="14" steps="............................x..."/>
